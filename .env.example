# Copy this file to .env.local and fill in real values.
# Never commit .env.local. Never put real keys in this file.

# --- Database (Phase 2) ---
# MongoDB Atlas connection string, e.g.
#   mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/kasityot?retryWrites=true&w=majority
# Note: the README specified PostgreSQL; the client chose MongoDB instead,
# so the data layer uses Mongoose rather than Prisma.
DATABASE_URL=

# --- Storage (Phase 3) ---
# Where uploaded artwork images and artist photos/videos are stored.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Admin auth (Phase 3) ---
# Single owner account. There is no public signup route anywhere in the app.
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=
SESSION_SECRET=

# --- Payments (Phase 4) ---
# Client's own Razorpay account.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- Site ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
