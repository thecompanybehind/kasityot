# Copy this file to .env.local and fill in real values.
# Never commit .env.local. Never put real keys in this file.

# --- Database (Phase 2) ---
# PostgreSQL connection string (Supabase or Neon).
DATABASE_URL=

# --- Storage (Phase 2/3) ---
# Supabase Storage for artwork images and artist photos/videos.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Admin auth (Phase 3) ---
# Single owner account. There is no public signup route anywhere in the app.
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=
SESSION_SECRET=

# --- Payments (Phase 4) ---
# Client's own Razorpay account.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- Site ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
