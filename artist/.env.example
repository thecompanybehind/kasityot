# The same Atlas cluster as the other two apps: one database, three surfaces.
DATABASE_URL="mongodb+srv://..."

# Must NOT match the owner panel's SESSION_SECRET. A shared secret would let a
# token minted here verify inside the admin app, leaving only a role claim
# between an artist and the owner's surface.
ARTIST_SESSION_SECRET="generate-with: openssl rand -base64 48"

# Artists upload photographs of their work.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""
