# The wholesaler panel, served at https://wholesaler.kasityot.com.
# Copy to .env.local. Never commit .env.local.

# The same Atlas cluster as the other three apps: one database, four surfaces.
DATABASE_URL="mongodb+srv://..."

# Must NOT match the owner panel's SESSION_SECRET or the studio's
# ARTIST_SESSION_SECRET, so a token minted on one surface can never verify on
# another. Generate with: openssl rand -base64 48
WHOLESALE_SESSION_SECRET=""

# Tells the owner about new registrations and trade enquiries. Optional: left
# empty, nothing is emailed and both still appear in the owner panel.
RESEND_API_KEY=""
NOTIFY_FROM_EMAIL=""
OWNER_EMAIL=""
