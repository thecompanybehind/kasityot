# Copy to .env.local in BOTH client/ and admin/. Never commit .env.local.

# --- Database (both apps) ---
# MongoDB Atlas connection string, including the database name:
#   mongodb+srv://USER:PASSWORD@cluster.mongodb.net/kasityot?retryWrites=true&w=majority
DATABASE_URL=

# --- Site URL (client) ---
# Used for canonical links, Open Graph images and sitemap.xml.
# In production this must be the real domain, e.g. https://kasityot.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Cloudinary (admin only: image uploads) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Admin auth (admin only) ---
# Single owner account. There is no signup route anywhere in the app.
ADMIN_EMAIL=
# bcrypt hash, base64-encoded. A raw bcrypt hash starts "$2b$12$..." and
# dotenv expands $VAR inside double quotes, which silently truncates it and
# makes every login fail. Generate with:
#   node -e "const b=require('bcryptjs');console.log(Buffer.from(b.hashSync(process.argv[1],12)).toString('base64'))" 'your-password'
ADMIN_PASSWORD_HASH_B64=
# openssl rand -hex 32
SESSION_SECRET=

# --- Razorpay (client only) ---
# From the CLIENT'S OWN Razorpay dashboard → Settings → API Keys.
# Use rzp_test_* keys until launch, then swap for rzp_live_*.
# Payment is disabled and the button reports "not configured" while blank.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# --- Owner notifications (client only, optional) ---
# Resend API key. Leave blank to skip emails — enquiries and orders are
# still recorded and visible in the admin panel either way.
RESEND_API_KEY=
OWNER_EMAIL=
NOTIFY_FROM_EMAIL=

# Where the artist studio is served, used to build invite links.
NEXT_PUBLIC_ARTIST_URL="http://localhost:3002"
